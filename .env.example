# Archivo de ejemplo para configuración de variables de entorno del Frontend
# Copiar este archivo como .env y ajustar según el entorno de despliegue

# URL base del API REST Backend Spring Boot
API_URL=http://localhost:8080/api/v1

# Configuración del servidor Keycloak (OAuth2 / OpenID Connect)
KEYCLOAK_URL=http://127.0.0.1:8081
KEYCLOAK_REALM=asistencias-uco
KEYCLOAK_CLIENT_ID=asistencias-uco-frontend

# Flag exclusivo para mocks del frontend (false para usar el backend configurado)
USE_MOCKS=false

# Security Baseline 0.1.7 es el proveedor normal; use legacy solo como alternativa explícita.
SECURITY_PROVIDER=baseline
SECURITY_BASELINE_URL=http://localhost:18080
SECURITY_BASELINE_UI_URL=http://localhost:5175
SECURITY_BASELINE_APPLICATION_ID=a0b42637-39f8-4ddd-bec2-0781ba08e779
SECURITY_BASELINE_ISSUER_URL=http://keycloak.localhost:19090/realms/security-baseline
SECURITY_BASELINE_CLIENT_ID=asistencias-uco-spa

# Catálogo de Parámetros (micro frontend parametros-administration.js). El UUID es el de la aplicación AsistenciasUCO
# en el Catálogo (el mismo CATALOGO_PARAMETROS_APPLICATION_ID del backend); no es secreto. Rutas del mismo origen.
CATALOGO_PARAMETROS_APPLICATION_ID=
CATALOGO_PARAMETROS_UI_URL=/parametros-ui/parametros-administration.js
CATALOGO_PARAMETROS_API_BASE_URL=/catalogo-parametros/api/v1
