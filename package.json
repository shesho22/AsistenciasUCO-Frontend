{
  "name": "gestio-asistencia-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:docker-runtime": "node scripts/verify-docker-runtime.mjs",
    "coverage:realtime:check": "node scripts/check-realtime-coverage.mjs",
    "e2e:realtime:smoke": "node scripts/realtime-smoke.mjs",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:tokens": "node scripts/check-design-tokens.mjs && node scripts/check-a11y-controles.mjs",
    "check:retiro-solicitudes": "node scripts/check-retiro-solicitudes.mjs",
    "check:registro-individual": "node scripts/check-registro-individual-retirado.mjs",
    "check:hu-en-ui": "node scripts/check-hu-en-ui.mjs",
    "verify": "npm run lint:tokens && npm run test:ci && npm run coverage:realtime:check && npm run check:retiro-solicitudes && npm run check:registro-individual && npm run check:hu-en-ui && npm run build -- --configuration=production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.4",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@lucide/angular": "^1.31.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "keycloak-js": "^26.0.0",
    "minifront-mensajes": "github:Jciro17/minifront-mensajes",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "9.39.5",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "9.39.5",
    "istanbul-lib-instrument": "6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
