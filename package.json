{
  "name": "gestio-asistencia-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:docker-runtime": "node scripts/verify-docker-runtime.mjs",
    "coverage:realtime:check": "node scripts/check-realtime-coverage.mjs",
    "e2e:realtime:smoke": "node scripts/realtime-smoke.mjs",
    "e2e": "npm run e2e:build && npm run e2e:run",
    "e2e:build": "ng build --configuration=production",
    "e2e:run": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:tokens": "node scripts/check-design-tokens.mjs && node scripts/check-a11y-controles.mjs",
    "check:retiro-solicitudes": "node scripts/check-retiro-solicitudes.mjs",
    "check:registro-individual": "node scripts/check-registro-individual-retirado.mjs",
    "check:hu-en-ui": "node scripts/check-hu-en-ui.mjs",
    "check:mensajes-ui": "node scripts/check-mensajes-ui.mjs",
    "check:openapi-contract": "node scripts/check-openapi-contract.mjs",
    "check:mensajes-ui-catalogo": "node scripts/sync-mensajes-ui-catalogo.mjs",
    "sync:mensajes-ui-catalogo": "node scripts/sync-mensajes-ui-catalogo.mjs --write",
    "check:matriz-hu": "node scripts/matriz-hu-pruebas.mjs",
    "sync:matriz-hu": "node scripts/matriz-hu-pruebas.mjs --write",
    "verify": "npm run lint:tokens && npm run test:ci && npm run coverage:realtime:check && npm run check:retiro-solicitudes && npm run check:registro-individual && npm run check:hu-en-ui && npm run check:mensajes-ui && npm run check:mensajes-ui-catalogo && npm run check:matriz-hu && npm run check:openapi-contract && npm run build -- --configuration=production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@lucide/angular": "^1.72.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "keycloak-js": "^26.2.5",
    "minifront-mensajes": "github:Jciro17/minifront-mensajes",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.9.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/jasmine": "~7.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.15.0",
    "istanbul-lib-instrument": "6.0.3",
    "jasmine-core": "~5.1.0",
    "js-yaml": "4.3.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
